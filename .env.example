# Copy to .env in this same folder before running `docker compose up --build`.
# Set LLM_PROVIDER to the provider you're using and fill the matching section.
# Unused ones can stay blank.

LLM_PROVIDER=gemini

# Gemini — genuinely free tier, no payment method. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Hugging Face (free token, open models via the HF router)
HF_TOKEN=your-hf-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama (fully local, no key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1