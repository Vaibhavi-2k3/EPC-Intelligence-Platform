# Pick a provider: gemini, openai, anthropic, huggingface, or ollama
# gemini has a genuinely free tier (no card needed) — good default for a
# hackathon submission. See README for how to get a free key for each option.
LLM_PROVIDER=gemini

# Only needed if LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey (no payment method required)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed if LLM_PROVIDER=huggingface
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Only needed if LLM_PROVIDER=ollama — no key required, runs on your machine.
# Install Ollama from https://ollama.com, then: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

PORT=3000
ML_SERVICE_URL=http://localhost:8000
